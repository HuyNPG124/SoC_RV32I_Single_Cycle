module TangNano20K_CORE (
  clk,
  rst,
  uart_rx,
  uart_tx,
  led_run
)
;
input clk;
input rst;
input uart_rx;
output uart_tx;
output led_run;
wire clk_d;
wire rst_d;
wire uart_rx_d;
wire \regfile[0]_ER_init ;
wire uart_tx_d;
wire [0:0] reset_sync;
wire VCC;
wire GND;
  IBUF clk_ibuf (
    .O(clk_d),
    .I(clk) 
);
  IBUF rst_ibuf (
    .O(rst_d),
    .I(rst) 
);
  IBUF uart_rx_ibuf (
    .O(uart_rx_d),
    .I(uart_rx) 
);
  OBUF uart_tx_obuf (
    .O(uart_tx),
    .I(uart_tx_d) 
);
  OBUF led_run_obuf (
    .O(led_run),
    .I(\regfile[0]_ER_init ) 
);
  DFFP reset_sync_0_s0 (
    .Q(reset_sync[0]),
    .D(GND),
    .CLK(clk_d),
    .PRESET(rst_d) 
);
  DFFP reset_sync_1_s0 (
    .Q(\regfile[0]_ER_init ),
    .D(reset_sync[0]),
    .CLK(clk_d),
    .PRESET(rst_d) 
);
  CORE CORE_uut (
    .clk_d(clk_d),
    .\regfile[0]_ER_init (\regfile[0]_ER_init ),
    .uart_rx_d(uart_rx_d),
    .uart_tx_d(uart_tx_d)
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* TangNano20K_CORE */
